  ],
  "syntax": {
    "comments": {
      "scope": ["comment", "punctuation.definition.comment"],
      "foreground": "comment",
      "fontStyle": "italic"
    },
    "keywords": {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "foreground": "keyword"
    },
    "types": {
      "scope": [
        "support.type",
        "support.class",
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.struct",
        "entity.name.trait",
        "entity.name.impl"
      ],
      "foreground": "type"
    },
    "functions": {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method",
        "support.method",
        "variable.function"
      ],
      "foreground": "function"
    },
    "strings": {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "foreground": "string"
    },
    "decorators": {
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "foreground": "decorator"
    },
    "constants": {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language",
        "constant.character.escape",
        "constant.other",
        "support.constant"
      ],
      "foreground": "constant"
    },
    "variables": {
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "foreground": "variable"
    },
    "parameters": {
      "scope": ["variable.parameter"],
      "foreground": "parameter"
    },
    "properties": {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.object.member"
      ],
      "foreground": "property"
    },
    "operators": {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.typeparameters"
      ],
      "foreground": "operator"
    },
    "invalid": {
      "scope": ["invalid", "invalid.illegal"],
      "foreground": "invalid",
      "fontStyle": "underline"
    }
  },
  "semanticTokenColors": {
    "namespace": "type",
    "type": "type",
    "typeParameter": "parameter",
    "class": "type",
    "interface": "type",
    "enum": "type",
    "enumMember": "constant",
    "function": "function",
    "method": "function",
    "macro": "keyword",
    "parameter": "parameter",
    "property": "property",
    "variable": "variable",
    "decorator": "decorator",
    "comment": { "foreground": "comment", "italic": true }
  }
}
